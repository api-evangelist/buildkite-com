{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buildkite Agent Access Token Agents API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Agents",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Agents",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://agent.buildkite.com/v3/organizations/:org/agents",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path",
                "description": "Organization slug"
              }
            ]
          },
          "docs": "List Agents"
        },
        {
          "info": {
            "name": "Get An Agent",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://agent.buildkite.com/v3/organizations/:org/agents/:id",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path",
                "description": "Organization slug"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Agent UUID"
              }
            ]
          },
          "docs": "Get An Agent"
        },
        {
          "info": {
            "name": "Stop An Agent",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://agent.buildkite.com/v3/organizations/:org/agents/:id/stop",
            "params": [
              {
                "name": "org",
                "value": "",
                "type": "path",
                "description": "Organization slug"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Agent UUID"
              }
            ]
          },
          "docs": "Stop An Agent"
        }
      ]
    }
  ],
  "bundled": true
}