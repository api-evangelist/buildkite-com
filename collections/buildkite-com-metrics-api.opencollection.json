{
  "opencollection": "1.0.0",
  "info": {
    "name": "Buildkite Agent Access Token Metrics API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Metrics",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Cluster Agent Metrics",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://agent.buildkite.com/v3/metrics"
          },
          "docs": "Returns current agent and job counts for the cluster associated with the agent token. Used by autoscalers (Lambda scaler, agent-stack-k8s, custom controllers) to size agent pools."
        }
      ]
    }
  ],
  "bundled": true
}